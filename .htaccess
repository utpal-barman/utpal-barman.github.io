# One canonical host: https://utpals.com
# The previous rule was collapsed onto a single line and never fired, which is why
# www.utpals.com still answers 200 instead of redirecting.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # force https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://utpals.com/$1 [R=301,L]

  # drop the www
  RewriteCond %{HTTP_HOST} ^www\.utpals\.com$ [NC]
  RewriteRule ^(.*)$ https://utpals.com/$1 [R=301,L]

  # the sitemap moved from /u/ to the root
  RewriteRule ^u/sitemap\.xml$ https://utpals.com/sitemap.xml [R=301,L]

  # add the trailing slash on real directories ourselves, so /tools/pdf serves
  # /tools/pdf/index.html. mod_dir would also do this, but behind a proxy its
  # self-referential redirect can name http://, costing an extra hop.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://utpals.com/$1/ [R=301,L]
</IfModule>

# a directory request serves its index
DirectoryIndex index.html

# compress text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# cache static assets hard, revalidate the page
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|css|js|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
